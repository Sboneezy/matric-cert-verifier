# ============================================================
# Matric Certificate Verifier — Environment Configuration
# Copy this file to .env and fill in real values.
# ============================================================

# Server
PORT=3000
NODE_ENV=development

# Security
ENCRYPTION_KEY=change-me-to-a-random-64-char-secret
API_KEY_SECRET=change-me-to-another-random-secret

# Database
DB_PATH=./data/matric-verifier.db

# SMTP (for email submission to providers)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=verifications@matric-verifier.co.za

# File uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info
